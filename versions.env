# DNS stack image pins (latest stable as of 2026-11-23 МСК).
# Sourced by compose via env_file / shell before `docker compose up`.
# Rollback: storage/rollback/versions.env.previous → dns rollback-images
#
# nginx 1.30.7: CVE-2026-123007 / 123633 (+ pack 18 Nov 2026). Was 1.30.6.

DNS_TECHNITIUM_IMAGE=docker.io/technitium/dns-server:15.6.2
DNS_BLOCKY_IMAGE=docker.io/spx01/blocky:v0.37.0
DNS_NGINX_IMAGE=docker.io/library/nginx:1.30.7-alpine
DNS_DOCKER_CLI_IMAGE=docker.io/library/docker:28-cli
