# Panel
PANEL_SESSION_SECRET=change-me-lab-secret

# Technitium (internal URL from panel container)
TECHNITIUM_URL=http://technitium:5380
# Пароль admin для синка forwarder обычно НЕ здесь:
# панель пишет config/panel/technitium_admin.pass при login / смене пароля.
# TECHNITIUM_ADMIN_PASSWORD=   # только если нужен override без UI

# First-boot / identity
DNS_SERVER_DOMAIN=dns-lab

# Published ports (lab: avoid 80/443/8000 used by neighbors)
DNS_UI_PORT=9080
DNS_UI_TLS_PORT=9443
DNS_DOT_PORT=853
# Optional: bind DNS :53 to LAN IP only (when podman aardvark holds 10.89.x:53)
# DNS_BIND_IP=172.29.110.165
# Фиксированный IP Blocky на dns_net (Technitium forwarder не плывёт)
# DNS_BLOCKY_IP=172.18.0.100
